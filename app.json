{
  "expo": {
    "name": "MatchLearn",
    "slug": "matchlearn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.matchlearn.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.matchlearn.app",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand-logo.png",
          "backgroundColor": "#ffffff",
          "imageWidth": 300
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MatchLearn uses your photos so you can upload a profile picture.",
          "microphonePermission": false,
          "cameraPermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8ccfa3ee-3b6a-45d6-81ad-91fc39e2c3c9"
      }
    }
  }
}
